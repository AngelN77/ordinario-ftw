<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos</title>
    <link rel="stylesheet" href="../css/estilos.css">
</head>
<body data-pagina="pedidos">
    <div id="menu"></div>

    <main>
        <section class="caja">
            <h1>Pedidos</h1>
            <p>En esta página se cargan pedidos desde XML y también se puede agregar uno en la tabla.</p>

            <form id="formPedido" class="formulario">
                <label for="cliente">Nombre del cliente:</label>
                <input type="text" id="cliente" required>

                <label for="postre">Postre:</label>
                <input type="text" id="postre" required>

                <label for="cantidad">Cantidad:</label>
                <input type="number" id="cantidad" min="1" required>

                <button type="submit">Agregar pedido</button>
            </form>
            <p id="mensajePedido"></p>
        </section>

        <section class="caja">
            <h2>Filtro de pedidos</h2>
            <label for="estado">Estado:</label>
            <select id="estado">
                <option value="todos">Todos</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Entregado">Entregado</option>
            </select>
        </section>

        <section class="caja">
            <h2>Tabla de pedidos</h2>
            <table>
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Postre</th>
                        <th>Cantidad</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody id="tablaPedidos"></tbody>
            </table>
        </section>
    </main>

    <div id="pie"></div>
    <script src="../jvS/componentes.js"></script>
    <script src="../jvS/app.js"></script>
</body>
</html>
